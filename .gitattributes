# ── Default behaviour ─────────────────────────────────────────
* text=auto eol=lf

# ── Source files ──────────────────────────────────────────────
*.php   text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.pot   text eol=lf
*.po    text eol=lf
*.mo    binary
*.md    text eol=lf
*.txt   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.sh    text eol=lf

# ── Binary files ──────────────────────────────────────────────
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.eot   binary
*.ttf   binary

